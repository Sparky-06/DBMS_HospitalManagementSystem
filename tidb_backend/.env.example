# Server Configuration
# Note: Keep PORT=5000 so the frontend works with zero changes!
PORT=5000
NODE_ENV=development

# TiDB Cloud Database Configuration
# Obtain these values from your TiDB Cloud Console (https://tidbcloud.com):
# Clusters -> Choose cluster -> Connect -> Connect with SQL client / Node.js
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_cluster_prefix.root
DB_PASSWORD=your_tidb_cloud_password
DB_NAME=hospital_pms

# TiDB Cloud SSL Configuration
# TiDB Cloud strictly requires TLS/SSL (TLS v1.2+)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional: Path to custom CA certificate bundle if needed
# DB_CA_PATH=

# Alternative: Full Connection URI
# If you prefer pasting the complete connection URI from TiDB Cloud console:
# DATABASE_URL=mysql://<user>:<password>@<host>:4000/hospital_pms?ssl={"rejectUnauthorized":true}

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
