{
  "name": "hospital-pms-tidb-backend",
  "version": "1.0.0",
  "description": "Hospital Patient Management System - Express and TiDB Cloud Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "db:test": "node src/scripts/testConnection.js",
    "db:init": "node src/scripts/initDb.js",
    "db:seed": "node src/scripts/seedDb.js"
  },
  "keywords": [
    "hospital-management",
    "express",
    "tidb",
    "tidb-cloud",
    "mysql",
    "rest-api"
  ],
  "author": "Person A",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "mysql2": "^3.11.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
